# ─── Required ─────────────────────────────────────────────
# Signs logins, and encrypts the keys saved in Settings unless ENCRYPTION_KEY is set.
# Changing it later makes every saved key unreadable. Generate: openssl rand -hex 32
JWT_SECRET=
# Guards Chomp's tool bridge and internal endpoints. Left unset, Chomp makes one in data/.mcp-secret.
# CHOMP_MCP_SECRET=
# ENCRYPTION_KEY=

# ─── Ollama (optional) ───────────────────────────────────
# Local embeddings for memory search: ollama pull nomic-embed-text.
# Without it, pick OpenAI or Gemini embeddings under Settings → AI and chat.
# API keys (OpenAI, Gemini, ...) are saved in Settings → API keys, not here.
OLLAMA_HOST=http://127.0.0.1:11434

# ─── Claude Code Agent ───────────────────────────────────
# Claude Code CLI must be installed and authenticated.
# No env var needed — it uses its own auth.
# The MCP bridge at packages/api/src/mcp/bridge.mjs
# connects the agent to Chomp's chat UI.

# ─── Telegram Bot (optional) ─────────────────────────────
TELEGRAM_API_KEY=
TELEGRAM_OWNER_ID=

# ─── Chewable Foodie (optional) ─────────────────────
# Recipe search & import via Chewable Foodie agent API
# Generate an API key from Chewable Foodie's settings
FOODIE_API_URL=http://localhost:5124
FOODIE_API_KEY=

# ─── Web Search (optional) ──────────────────────────────
# SearXNG instance for web search tool
# Can also be set via Settings UI
SEARXNG_URL=http://localhost:8080

# ─── Server ──────────────────────────────────────────────
PORT=3001
# Address to listen on. 127.0.0.1 (default) is reached through `tailscale serve`; 0.0.0.0 also opens it to your LAN.
# HOST=127.0.0.1
# Time zone for rules, reminders and the morning brief. Defaults to this machine's;
# set it in Docker, where containers run in UTC. Example: TZ=Europe/Oslo
# TZ=
DB_PATH=./data/chomp.db
# Required for the server to open a non-/tmp (production) database. The db module
# refuses to open any non-ephemeral DB without this, so a stray test/script can't
# silently wipe prod. `pnpm dev` sets it automatically; set it here for `pnpm start`
# / systemd. Tests use a /tmp DB and do NOT need (or set) this.
CHOMP_ALLOW_PROD_DB=1

# ─── Production (Docker only) ────────────────────────────
# REDIS_URL=redis://redis:6379

# ─── Personal deployment configuration ───────────────────
# Set these in your ignored .env; shared defaults contain no personal details.
# The address you open Chomp at, used in links it sends you (Morning brief, sites, Google and
# Spotify login). With Tailscale: https://<machine>.<tailnet>.ts.net
# CHOMP_DOMAIN=https://chomp.example.com
# Published sites: Chomp serves them at <CHOMP_DOMAIN>/pub/<site>/. Set PREVIEW_DOMAIN only if
# your own web server serves PREVIEW_SITES_DIR on that hostname instead.
# PREVIEW_DOMAIN=preview.example.com
# PREVIEW_SITES_DIR=/absolute/path/to/preview-sites
SITE_GIT_AUTHOR_NAME=Chomp
SITE_GIT_AUTHOR_EMAIL=chomp@example.invalid
# GitHub login invited as admin to new site repos. Empty: nobody is invited.
SITE_GIT_INVITE_COLLABORATOR=
# Unset entities disable location tracking/context enrichment.
HOMEASSISTANT_LOCATION_ENTITY=
HOMEASSISTANT_GEOCODED_ENTITY=
# Example values: device_tracker.my_phone / sensor.my_phone_geocoded_location
# Cleanup is disabled until explicit repositories are configured (absolute paths).
WORKTREE_CLEANUP_REPOS=[]
# WORKTREE_CLEANUP_REPOS='[{"path":"/absolute/path/to/repo","remote":"origin"}]'
PHONE_CALENDAR_WORK_NAMES=calendar
PHONE_CALENDAR_SKIP_NAMES=birthdays,holidays
PHONE_CALENDAR_TIMEZONE=UTC
# SEC requests require your application's name and contact email.
SEC_USER_AGENT=
# Browser-visible build-time config: exact origins, comma-separated. Never secrets.
VITE_EMBED_ALLOWED_ORIGINS=
# Public address of the webhook tunnel, shown on the Webhooks page. Empty: this server's address.
VITE_WEBHOOKS_ORIGIN=
# Bundle id of your build of the iOS app, for push notifications.
APNS_BUNDLE_ID=
# VITE_EMBED_ALLOWED_ORIGINS=https://remote.example.com:8451
